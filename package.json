{
  "name": "crimson-tasks",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start-local.mjs",
    "typecheck": "tsc --noEmit",
    "test:integration": "node tests/api.integration.mjs",
    "test:security": "node scripts/test-security.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "local:up": "node scripts/local.mjs up",
    "local:down": "node scripts/local.mjs down",
    "local:logs": "node scripts/local.mjs logs",
    "local:status": "node scripts/local.mjs status"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "next": "16.4.6",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "pg-pool": "3.10.1",
    "pg-connection-string": "2.9.1"
  }
}
